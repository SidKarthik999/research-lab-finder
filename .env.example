# Copy to .env for local dev (python-dotenv loads it automatically).
# In production these are set as real environment variables/secrets on the
# host (see render.yaml) -- .env itself is gitignored and never deployed.

# --- Local ingestion pipeline (src/ingestion/*) ---
OPENALEX_API_KEY=
OPENALEX_EMAIL=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Web app (backend/*) ---
# Unset locally -- falls back to the hardcoded local Postgres connection in
# src/database.py. Required in production (Neon connection string). Don't
# set this in your own .env, though -- the launchd ingestion scripts
# (scripts/run_*.sh) instead read a separate .env.production for this one
# variable, so local dev/tests keep defaulting to local Postgres. See
# docs/ROADMAP.md Phase 6.3.
DATABASE_URL=
# Signs session cookies (backend/main.py's SessionMiddleware). No default --
# the app fails loudly at startup if this is unset. Generate a fresh value
# per environment, never reuse dev's in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# backend/llm.py: AI summaries, cold-email drafts, resume PDF import.
# Endpoints return a clean 503 (not a crash) if this is unset.
OPENAI_API_KEY=
# backend/google_auth.py: "Continue with Google". GET /api/auth/google/client-id
# returns null (and the frontend hides the button) if unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# backend/email.py. Only "console" (prints to stdout/logs) is implemented
# today -- see docs/ROADMAP.md Phase 6.2 for the still-open production
# email provider decision.
EMAIL_BACKEND=console
